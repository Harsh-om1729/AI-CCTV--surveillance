LOG_LEVEL=INFO

# standard | low. "low" tunes for an Intel i3/i5-class box with no GPU: a
# 416-input detector, fewer Re-ID/face re-checks, one ORT thread per model and
# a lower idle rate (README "Phase 26"). Any of those four settings set
# explicitly further down still wins over the profile.
HARDWARE_PROFILE=standard

# Comma-separated name=source pairs. Source is a webcam index (0, 1, ...) or an RTSP URL.
# Example with two cameras: CAMERA_SOURCES=cam0=0,cam1=rtsp://192.168.1.10:554/stream1
CAMERA_SOURCES=cam0=0

# Optional: fix a camera's whole frame to one zone tier instead of drawing
# polygons for it. Use this when a camera is physically mounted at one point
# along the border (e.g. right at the fence) so its entire view is always
# that tier - no 'z' key, no config/zones_<camera>.json needed for it.
# A camera not listed here is unaffected and keeps using drawn zones.
# Example: CAMERA_ZONE_TIERS=cam0=red,cam1=yellow,cam2=green
CAMERA_ZONE_TIERS=

# 0-255 scale; frames measured below this trigger a CLAHE + gamma low-light boost
BRIGHTNESS_THRESHOLD=90

# Mean grayscale frame-diff above this counts as "activity detected"
MOTION_THRESHOLD=2.0

# When idle (no motion), run the full pipeline at least this many times per
# second. A floor, not a cap — motion lifts it back to every frame.
# Default from HARDWARE_PROFILE (standard 20, low 5); uncomment to pin.
# IDLE_MIN_FPS=20

# Minimum YOLO confidence to keep a detection
DETECTION_CONFIDENCE=0.5

# Path to the model file the detector loads (.pt, .onnx, or an int8 .onnx).
# Default from HARDWARE_PROFILE: standard -> models/yolov8s.onnx, low ->
# models/yolov8n_416.onnx (a 416-input export; 4.3x faster than yolov8s with
# no accelerator, no precision/recall loss on the reviewed eval frames). A
# fixed-size export's input size is read from the file, so 640/416/320 ONNX
# exports all work here. Uncomment to pin a model regardless of profile.
# DETECTION_MODEL_PATH=models/yolov8s.onnx

# Requested camera capture resolution (cameras often default to 1080p, which
# is unnecessary and slows every downstream stage)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Re-ID: cosine similarity (0-1) above which a reappearing track is matched
# back to an existing person instead of being treated as a new one
REID_SIMILARITY_THRESHOLD=0.7

# Re-ID: how long (seconds) a disappeared person stays eligible for matching
REID_TTL_SECONDS=30

# Green zones are re-tiered to "yellow" during this hour window (wraps midnight)
CURFEW_START_HOUR=23
CURFEW_END_HOUR=5

# Seconds between repeat alerts for the same track at the same tier
ALERT_COOLDOWN_SECONDS=8

# Phase 18: a tier must be sustained for at least this many REAL SECONDS (not
# scoring cycles) before it alerts, and only clears once it has sat below that
# tier for the same duration. Raise this if alerts feel too quick/trigger-happy.
ALERT_CONFIRM_SECONDS=1.5
# Fraction of observations in that window that must be at/above a tier to
# confirm it - 0.5 = elevated at least half the time.
ALERT_CONFIRM_FRACTION=0.5

# Ceiling for the repeat-alert backoff (8 -> 16 -> 32 -> ... -> this)
ALERT_MAX_COOLDOWN_SECONDS=64

# How long (seconds) the dashboard's live per-camera status holds at its
# highest recent tier before decaying. Without this, the status flickers
# yellow/red for a single frame at a time whenever a score sits near a tier
# boundary - separate from the ALERT_* settings above, which only govern
# when an incident gets recorded, not what the live status badge shows.
MAX_TIER_HOLD_SECONDS=6

# Cosine similarity (0-1) above which a face is treated as a watchlist match
WATCHLIST_SIMILARITY_THRESHOLD=0.7

# Outbound webhook URL for alert events (empty = disabled)
WEBHOOK_URL=

# Bearer token for the integration REST API (integration/api.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = the API refuses all requests (503). Enforced in integration/api.py.
IBVAP_API_TOKEN=

# Browser origins allowed to call /api/v1 (the React dashboard in frontend/).
# Comma-separated. Vite's dev server is :5173. Never "*" — these routes carry
# the bearer token above.
IBVAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = also accept dashboard origins from private LAN addresses (192.168.x,
# 10.x, 172.16-31.x), so a phone on the same Wi-Fi can open the dashboard.
# ./run.sh up sets this for you. The bearer token is still required.
IBVAP_ALLOW_LAN=0

# Syslog target for alert events (UDP; fire-and-forget, safe if unreachable)
SYSLOG_HOST=localhost
SYSLOG_PORT=514

# Re-run Re-ID + face/watchlist recognition for an already-resolved track
# only every Nth frame, not every frame (measured ~14ms/person/frame saved).
# Default from HARDWARE_PROFILE (standard 5, low 10); uncomment to pin.
# REID_FACE_CHECK_INTERVAL=5

# Intra-op threads per ONNX Runtime session. The pipeline runs three sessions
# (YOLO, Re-ID, face); unbounded they oversubscribe the CPU and contend.
# 2 = lowest latency on a many-core machine, 1 = lowest CPU, 0 = let ORT decide.
# Default from HARDWARE_PROFILE (standard 2, low 1); uncomment to pin.
# ORT_NUM_THREADS=2

# Execution providers the Re-ID and face models request, in order. Unset =
# OpenVINO if onnxruntime-openvino is installed, else CPU. The detector picks
# its own provider (Ultralytics), so this doesn't affect it.
# ORT_PROVIDERS=OpenVINOExecutionProvider,CPUExecutionProvider

# Where the watchlist embedding-encryption key lives. Created on first use.
WATCHLIST_KEY_PATH=database/watchlist.key

# Bounded queue size for background alert side effects.
ALERT_DISPATCH_QUEUE_SIZE=64
